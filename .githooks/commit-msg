#!/usr/bin/env sh
# ----------------------------------------------------------------
# Hook: Git Semantic Commit-Message Validator (Competitive Computing)
# License: MIT (c) 2026 GabrielFrigo
# ----------------------------------------------------------------

set -e

_msg_file="${1:-}"
if [ -z "${_msg_file}" ] || [ ! -f "${_msg_file}" ]; then
	exit 0
fi

_clean_msg=$(grep -v '^[[:space:]]*#' "${_msg_file}" | tr '\n' ' ' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

case "${_clean_msg}" in
	Merge*|Revert*|fixup!*|squash!*)
		exit 0
		;;
esac

if [ -z "${_clean_msg}" ]; then
	echo "❌ [commit-msg] A mensagem de commit não pode estar vazia!" >&2
	exit 1
fi

_char_count=$(printf "%s" "${_clean_msg}" | wc -m)
if [ "${_char_count}" -lt 8 ]; then
	echo "❌ [commit-msg] Mensagem muito curta (mínimo de 8 caracteres)." >&2
	exit 1
fi

_pattern='^(feat|fix|refactor|docs|style|test|chore|perf|ci|solution|algo)(\([a-zA-Z0-9_.\/-]+\))?!?:[[:space:]]+.+'
if ! echo "${_clean_msg}" | grep -E -q "${_pattern}"; then
	echo "❌ [commit-msg] Convenção Conventional Commits violada!" >&2
	echo "   Formato esperado:" >&2
	echo "     <tipo>(<escopo opcional>): <descrição>" >&2
	echo "   Exemplos válidos:" >&2
	echo "     solution(codeforces): solve div2 1000 problem A" >&2
	echo "     algo(graphs): add dinic max flow implementation" >&2
	echo "     feat(tools): add multi-language support to cpt" >&2
	echo "   Tipos permitidos: feat, fix, refactor, docs, style, test, chore, perf, ci, solution, algo" >&2
	exit 1
fi

exit 0
