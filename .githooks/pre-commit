#!/usr/bin/env sh

### ================================
### PRE-COMMIT HOOK
### ================================

set -e

### --------------------------------
### Setup & Repository Root
### --------------------------------
_repo_root="$(git rev-parse --show-toplevel 2> "/dev/null" || pwd)"
cd "${_repo_root}"

echo "🔍 [pre-commit] Executing Competitive Computing quality gates..."

### --------------------------------
### Whitespace & Formatting Check
### --------------------------------
echo "  ↳ Checking whitespace and formatting (git diff --check)..."
if ! git diff --check --cached; then
	echo "❌ [pre-commit] Whitespace or EOF formatting error detected!" >&2
	echo "   Run 'git diff --check --cached' to inspect issues." >&2
	exit 1
fi

### --------------------------------
### Forbidden Binaries Check
### --------------------------------
echo "  ↳ Checking for compiled binaries in stage..."
_staged_files=$(git diff --cached --name-only --diff-filter=ACM)

if [ -n "${_staged_files}" ]; then
	_forbidden_ext="exe|out|app|bin|o|obj|a|so|dylib|gch|pch|class"
	_forbidden_names="^(main|test|sol|solution|a\.out|main_bin)$"
	_has_binary=0

	for _file in ${_staged_files}; do
		_base=$(basename "${_file}")
		_ext="${_file##*.}"

		if echo "${_base}" | grep -E -q "${_forbidden_names}"; then
			echo "❌ [pre-commit] Executable binary detected: ${_file}" >&2
			_has_binary=1
		elif echo "${_ext}" | grep -E -q "^(${_forbidden_ext})$"; then
			echo "❌ [pre-commit] Binary extension detected: ${_file}" >&2
			_has_binary=1
		fi
	done

	if [ "${_has_binary}" -ne 0 ]; then
		echo "   Run 'git rm --cached <file>' to unstage binaries." >&2
		exit 1
	fi
fi

### --------------------------------
### Large Files Protection (>5MB)
### --------------------------------
echo "  ↳ Enforcing file size limit (5MB)..."
_max_size=5242880
if [ -n "${_staged_files}" ]; then
	for _file in ${_staged_files}; do
		if [ -f "${_file}" ]; then
			_size=$(stat -c "%s" "${_file}" 2> "/dev/null" || wc -c < "${_file}")
			if [ "${_size}" -gt "${_max_size}" ]; then
				echo "❌ [pre-commit] File exceeds 5MB limit: ${_file}" >&2
				exit 1
			fi
		fi
	done
fi

### --------------------------------
### Python Scripts Syntax Check
### --------------------------------
echo "  ↳ Validating Python CLI tools (py_compile)..."
python3 -m py_compile tools/cp_tool.py tests/test_cp_tool.py

### --------------------------------
### Markdown Prettier Validation
### --------------------------------
if command -v prettier > "/dev/null" 2>&1; then
	echo "  ↳ Validating staged Markdown files with Prettier..."
	_unformatted_md=""
	for _md_file in $(git diff --cached --name-only --diff-filter=d | grep '\.md$' || true); do
		if [ -f "${_md_file}" ] && ! prettier --check "${_md_file}" > "/dev/null" 2>&1; then
			_unformatted_md="${_unformatted_md} ${_md_file}"
		fi
	done
	if [ -n "${_unformatted_md}" ]; then
		echo "❌ [pre-commit] Unformatted Markdown files detected:${_unformatted_md}" >&2
		echo "   Run 'prettier --write <file>'." >&2
		exit 1
	fi
fi

echo "✅ [pre-commit] All Competitive Computing quality gates passed cleanly!"
exit 0
