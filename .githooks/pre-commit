#!/usr/bin/env bash
# ==============================================================================
# Git Pre-commit Hook for Competitive Programming Hub
# Protects against large files, binaries, merge conflicts and syntax errors.
# ==============================================================================

set -e

RED="\033[0;31m"
GREEN="\033[0;32m"
YELLOW="\033[0;33m"
CYAN="\033[0;36m"
NC="\033[0m"

echo -e "${CYAN}[pre-commit] Verificando integridade dos arquivos preparados...${NC}"

# 1. Bloquear binários e executáveis acidentalmente commitados
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

FORBIDDEN_EXTENSIONS="exe|out|app|bin|o|obj|a|so|dylib|gch|pch|class"
FORBIDDEN_NAMES="^(main|test|sol|solution|a\.out|main_bin)$"

HAS_FORBIDDEN_BINARY=0
for FILE in $STAGED_FILES; do
    BASENAME=$(basename "$FILE")
    EXT="${FILE##*.}"

    if echo "$BASENAME" | grep -Eq "$FORBIDDEN_NAMES"; then
        echo -e "${RED}[ERRO] Arquivo executável detectado no commit: $FILE${NC}"
        HAS_FORBIDDEN_BINARY=1
    elif echo "$EXT" | grep -Eq "^($FORBIDDEN_EXTENSIONS)$"; then
        echo -e "${RED}[ERRO] Extensão binária proibida detectada: $FILE${NC}"
        HAS_FORBIDDEN_BINARY=1
    fi
done

if [ "$HAS_FORBIDDEN_BINARY" -ne 0 ]; then
    echo -e "${RED}Remova os binários do stage com 'git rm --cached <arquivo>' antes de commitar.${NC}"
    exit 1
fi

# 2. Bloquear arquivos maiores que 5MB (5242880 bytes)
MAX_SIZE=5242880
LARGE_FILES=0
for FILE in $STAGED_FILES; do
    if [ -f "$FILE" ]; then
        SIZE=$(stat -c%s "$FILE" 2>/dev/null || wc -c < "$FILE")
        if [ "$SIZE" -gt "$MAX_SIZE" ]; then
            echo -e "${RED}[ERRO] Arquivo excede o limite de 5MB ($(($SIZE / 1024 / 1024))MB): $FILE${NC}"
            LARGE_FILES=1
        fi
    fi
done

if [ "$LARGE_FILES" -ne 0 ]; then
    echo -e "${RED}Arquivos grandes não devem ser commitados no repositório.${NC}"
    exit 1
fi

# 3. Bloquear marcadores de conflito de merge não resolvidos
CONFLICT_PATTERNS="^[<]{7} |^[=]{7}$|^[>]{7} "
for FILE in $STAGED_FILES; do
    if [ -f "$FILE" ] && grep -Eq "$CONFLICT_PATTERNS" "$FILE" 2>/dev/null; then
        echo -e "${RED}[ERRO] Marcador de conflito de merge detectado em: $FILE${NC}"
        exit 1
    fi
done

# 4. Validar sintaxe de scripts Python staged
for FILE in $STAGED_FILES; do
    if [[ "$FILE" == *.py ]] && [ -f "$FILE" ]; then
        if command -v python3 >/dev/null 2>&1; then
            if ! python3 -m py_compile "$FILE" 2>/dev/null; then
                echo -e "${RED}[ERRO] Erro de sintaxe Python no arquivo: $FILE${NC}"
                exit 1
            fi
        fi
    fi
done

# 5. Soft-check de sintaxe C++ em arquivos staged (se g++ estiver disponível)
if command -v g++ >/dev/null 2>&1; then
    for FILE in $STAGED_FILES; do
        if [[ "$FILE" =~ \.(cpp|hpp|cc|cxx)$ ]] && [ -f "$FILE" ]; then
            # Testa a sintaxe sem gerar arquivo (-fsyntax-only)
            if ! g++ -std=c++23 -fsyntax-only "$FILE" >/dev/null 2>&1; then
                # Apenas um aviso amigável caso dependa de includes relativos locais
                echo -e "${YELLOW}[AVISO] Verifique a compilação do arquivo C++: $FILE${NC}"
            fi
        fi
    done
fi

echo -e "${GREEN}✔ [pre-commit] Todas as verificações passaram com sucesso!${NC}"
exit 0
