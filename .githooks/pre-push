set -e

printf "\033[36m[pre-push] Executando verificação de integridade antes do envio...\033[0m\n"

_repo_root="$(git rev-parse --show-toplevel 2> "/dev/null" || pwd)"

if [ -f "${_repo_root}/Makefile" ]; then
	if command -v gmake > "/dev/null" 2>&1; then
		gmake -C "${_repo_root}" lint --no-print-directory
	elif make --version 2>&1 | grep -qi "gnu"; then
		make -C "${_repo_root}" lint --no-print-directory
	else
		make -C "${_repo_root}" lint -s
	fi
else
	printf "\033[32mMakefile não encontrado, pulando pre-push checks.\033[0m\n"
fi

printf "\033[32m✔ [pre-push] Verificações concluídas! Prosseguindo com o push.\033[0m\n"
exit 0
